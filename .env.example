# Copy to .env and fill in. NEVER commit .env.
# Make each random secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
NID_HMAC_KEY=
JWT_SIGNING_KEY=
# Ed25519 signing key (32 random bytes, base64):
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
SIGNING_PRIVATE_KEY=
SIGNING_KEY_ID=k1
FRONTEND_BASE_URL=http://localhost:3000
# 1 when the Next.js frontend server calls Django (the usual setup)
TRUSTED_PROXY_COUNT=1
# Optional: move the admin site, e.g. office-x7k2/
DJANGO_ADMIN_PATH=admin/
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=bhumipatra
DB_USER=bhumipatra
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
